{
  "name": "Wisely — Budget",
  "short_name": "Wisely",
  "description": "Cards, budgets, goals and insights in one calm place. Private and offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0B0914",
  "theme_color": "#0B0914",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text" }
  },
  "shortcuts": [
    { "name": "Add expense", "short_name": "Expense", "url": "./?add=expense" },
    { "name": "Add income", "short_name": "Income", "url": "./?add=income" }
